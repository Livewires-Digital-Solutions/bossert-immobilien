# ─────────────────────────────────────────────────────────
# Bossert Immobilien — environment template
# Copy to .env.local (dev) or .env.production and fill in real values.
# .env* files are gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────

# ── Database (MySQL) ──────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/bossert_auth"

# ── Backend Kill-Switch ───────────────────────────────────
# Server-side switch — controls DB/Prisma init, NextAuth, onOffice calls, all /api backend logic.
# Default when unset/missing: "false" (safe default — backend OFF) to avoid accidental prod DB writes.
BACKEND_ENABLED="false"

# Client-safe mirror — ONLY exposes the boolean, never secrets, to Client Components that need to
# conditionally skip fetches (e.g. property listing calling /api/properties).
NEXT_PUBLIC_BACKEND_ENABLED="false"

# ── Super Admin (seeded into the DB by `npm run db:seed`) ──
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="superadmin@bossert-immobilien.de"
SUPERADMIN_PASSWORD="change-me"

# ── Admin dashboard access ────────────────────────────────
# Comma-separated emails allowed into /admin (plus any ADMIN/SUPERADMIN role).
ADMIN_EMAILS="superadmin@bossert-immobilien.de"

# ── Auth.js / NextAuth ────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-random-value"
NEXTAUTH_SECRET="generate-a-random-value"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (SMTP) ──────────────────────────────────────────
# Leave EMAIL_SERVER_HOST blank in dev to log password-reset links
# to the server console instead of sending email.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Bossert Immobilien <no-reply@bossert-immobilien.de>"

# ── File Uploads ──────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=20

# ── onOffice API (HMAC v2) ────────────────────────────────
# Used by /admin/properties to import estates and by the public property pages.
# Leave TOKEN/SECRET blank to disable the integration (admin shows a notice).
ONOFFICE_TOKEN=""
ONOFFICE_SECRET=""
ONOFFICE_API_URL="https://api.onoffice.de/api/latest/api.php"
# Local machine clock offset vs onOffice servers, in seconds (subtracted from now).
ONOFFICE_TS_OFFSET_S="270"

# ── Site ──────────────────────────────────────────────────
# Used to build absolute links (e.g. password-reset URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
