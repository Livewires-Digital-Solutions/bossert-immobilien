// Bossert Immobilien — Prisma schema
// Datasource: MySQL (see DATABASE_URL in .env.local / .env.production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────
// Auth.js (NextAuth v5) core models
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hex of the raw token; the raw token is never stored
  expires   DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Property domain (consumed by src/lib/seed-properties.ts)
// ─────────────────────────────────────────────

model Property {
  id            String         @id @default(cuid())
  type          String
  status        PropertyStatus @default(DRAFT)
  featured      Boolean        @default(false)
  priceDisplay  String
  priceValue    Int
  location      String
  specs         String
  beds          Int
  baths         Int
  areaSqm       Int
  heroImage     String
  descriptionEn String         @db.Text
  descriptionDe String         @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  amenities PropertyAmenity[]
  schools   NearbySchool[]
  transport NearbyTransport[]

  @@index([status])
  @@index([featured])
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model NearbySchool {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  distance   String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model NearbyTransport {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  type       String
  distance   String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
